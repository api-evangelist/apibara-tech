{
  "tools": [
    {
      "name": "search_auction_vehicles",
      "title": "Search auction vehicles",
      "description": "Search supported Copart and IAAI vehicle auction records. Use exact documented filters; fields can be nullable and source-dependent.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "s": {
            "type": "string",
            "description": "VIN, lot number or title search."
          },
          "platform": {
            "type": "string",
            "enum": [
              "copart",
              "iaai"
            ]
          },
          "lot_status": {
            "type": "string",
            "enum": [
              "All",
              "Timed",
              "Buy Now"
            ]
          },
          "lot_sub_status": {
            "type": "string",
            "enum": [
              "Open",
              "Live",
              "Ended"
            ]
          },
          "upcoming": {
            "type": "string",
            "enum": [
              "all",
              "only",
              "without"
            ]
          },
          "updated_within_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 525600
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year_from": {
            "type": "integer"
          },
          "year_to": {
            "type": "integer"
          },
          "price_min": {
            "type": "number"
          },
          "price_max": {
            "type": "number"
          },
          "facility_id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "loc_state": {
            "type": "string"
          },
          "today_only": {
            "type": "boolean"
          },
          "has_shipping_price": {
            "type": "boolean"
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_vehicle",
      "title": "Get vehicle",
      "description": "Retrieve one supported vehicle record by the VIN or slug_vin accepted by the canonical detail endpoint.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "description": "VIN or slug_vin accepted by the canonical vehicle detail endpoint."
          }
        },
        "required": [
          "identifier"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_vehicle_history",
      "title": "Get vehicle auction history",
      "description": "Retrieve retained Copart + IAAI auction history for one supported vehicle when available. This is not a complete ownership or accident history.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "description": "VIN or slug_vin accepted by the canonical vehicle detail endpoint."
          }
        },
        "required": [
          "identifier"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_related_vehicles",
      "title": "Get related vehicles",
      "description": "Retrieve related supported auction vehicles.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "description": "VIN or slug_vin accepted by the canonical vehicle detail endpoint."
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "identifier"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_vehicle_filters",
      "title": "Get vehicle filters",
      "description": "Retrieve current supported filter metadata for search UIs and integrations.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "copart",
              "iaai"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
