        "openWorldHint": true
      }
    },
    {
      "name": "list_auction_locations",
      "title": "List auction locations",
      "description": "Retrieve supported auction facilities and locations.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "copart",
              "iaai"
            ]
          },
          "s": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "calculate_shipping",
      "title": "Calculate auction-to-port shipping",
      "description": "Retrieve supported auction-to-port shipping information by VIN or lot number when location and route data are available.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vin": {
            "type": "string"
          },
          "lot_number": {
            "type": "string"
          },
          "port": {
            "type": "string"
          },
          "port_id": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "vin"
            ]
          },
          {
            "required": [
              "lot_number"
            ]
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_api_usage",
      "title": "Get API usage",
      "description": "Retrieve authenticated API usage and current plan limits for the supplied X-API-Key.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ],
  "ttlMs": 3600000,
  "cacheScope": "public"
